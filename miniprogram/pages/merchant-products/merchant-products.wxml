<view class="container">
  <view class="top-bar flex flex-between flex-center">
    <view class="filter-bar">
      <view class="filter-item {{statusFilter === '' ? 'active' : ''}}" bindtap="changeFilter" data-s="">全部</view>
      <view class="filter-item {{statusFilter === '1' ? 'active' : ''}}" bindtap="changeFilter" data-s="1">上架</view>
      <view class="filter-item {{statusFilter === '0' ? 'active' : ''}}" bindtap="changeFilter" data-s="0">下架</view>
    </view>
    <view class="add-btn" bindtap="addProduct">+ 添加</view>
  </view>

  <view class="product-item card" wx:for="{{products}}" wx:key="id">
    <view class="tag {{item.status === 1 ? 'tag-green' : 'tag-gray'}}">{{item.status === 1 ? '上架' : '下架'}}</view>
    <view class="flex" style="gap:20rpx">
      <image class="prod-img" src="{{item.images[0] || defaultImg}}" mode="aspectFill"/>
      <view class="flex-1">
        <text class="prod-name">{{item.name}}</text>
        <text class="prod-price price"><text class="price-unit">¥</text>{{item.price}}</text>
        <view class="prod-meta">
          <text>库存: {{item.stock}}</text>
          <text style="margin-left:16rpx">销量: {{item.sales}}</text>
        </view>
      </view>
    </view>
    <view class="prod-actions">
      <text class="action-btn" bindtap="toggleStatus" data-id="{{item.id}}" data-status="{{item.status}}">
        {{item.status === 1 ? '下架' : '上架'}}
      </text>
      <text class="action-btn" bindtap="editProduct" data-id="{{item.id}}">编辑</text>
      <text class="action-btn del" bindtap="deleteProduct" data-id="{{item.id}}">删除</text>
    </view>
  </view>

  <view class="empty-state" wx:if="{{products.length === 0}}">
    <image class="icon-lg" src="/images/icons/pickup.png" mode="aspectFit"/>
    <text>暂无商品</text>
  </view>
</view>
