.top-bar { margin-bottom: 16rpx; }
.filter-bar { display: flex; gap: 12rpx; }
.filter-item { padding: 10rpx 24rpx; border-radius: 24rpx; font-size: 24rpx; background: #fff; color: #505F79; }
.filter-item.active { background: #36B37E; color: #fff; }
.add-btn { background: #36B37E; color: #fff; padding: 10rpx 24rpx; border-radius: 24rpx; font-size: 24rpx; font-weight: 600; }

.product-item { position: relative; padding-top: 48rpx !important; }
.prod-img { width: 140rpx; height: 140rpx; border-radius: 12rpx; flex-shrink: 0; }
.prod-name { font-size: 28rpx; font-weight: 600; color: #172B4D; display: block; margin-bottom: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 360rpx; }
.prod-price { font-size: 30rpx; display: block; margin-bottom: 8rpx; }
.prod-meta { font-size: 22rpx; color: #8F92A1; }

.tag { position: absolute; top: 20rpx; right: 20rpx; font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 16rpx; z-index: 1; }
.tag-green { background: #E3FCEF; color: #00875A; }
.tag-gray { background: #F4F5F7; color: #8F92A1; }

.prod-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F1F5;
}
.action-btn {
  font-size: 24rpx;
  color: #36B37E;
  padding: 10rpx 28rpx;
  border: 1rpx solid #36B37E;
  border-radius: 24rpx;
  text-align: center;
  line-height: 1;
}
.action-btn.del { color: #FF5630; border-color: #FF5630; }
