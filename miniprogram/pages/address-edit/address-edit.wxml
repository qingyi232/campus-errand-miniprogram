<view class="container">
  <view class="card">
    <view class="form-group">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onInput" data-field="name"/>
    </view>
    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入手机号" value="{{form.phone}}" bindinput="onInput" data-field="phone"/>
    </view>
    <view class="form-group">
      <text class="form-label">校区</text>
      <picker range="{{campusList}}" bindchange="onCampusChange">
        <view class="form-input" style="display:flex;align-items:center;justify-content:space-between;line-height:88rpx;">
          <text>{{form.campus || '请选择校区'}}</text><text style="color:#B0B3BE">▾</text>
        </view>
      </picker>
    </view>
    <view class="form-group">
      <text class="form-label">宿舍楼</text>
      <input class="form-input" placeholder="如：梅园1号楼" value="{{form.dormitory}}" bindinput="onInput" data-field="dormitory"/>
    </view>
    <view class="form-group">
      <text class="form-label">详细地址</text>
      <input class="form-input" placeholder="如：302室" value="{{form.detail}}" bindinput="onInput" data-field="detail"/>
    </view>
    <view class="flex flex-center" style="justify-content:space-between;margin-top:20rpx;">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{form.is_default}}" bindchange="onDefaultChange" color="#36B37E"/>
    </view>
  </view>
  <view class="btn-primary" style="margin-top:40rpx" bindtap="save">保存</view>
</view>
