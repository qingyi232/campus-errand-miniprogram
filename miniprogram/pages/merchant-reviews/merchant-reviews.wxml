<view class="container">
  <view class="stats-bar card">
    <view class="flex flex-center" style="justify-content:center;gap:16rpx">
      <text class="avg-score">{{avgRating}}</text>
      <view>
        <view class="avg-stars-wrap">
          <image wx:for="{{5}}" wx:key="*this" class="star-icon-sm" src="/images/icons/star.png" mode="aspectFit"/>
        </view>
        <text class="avg-count">共 {{reviews.length}} 条评价</text>
      </view>
    </view>
  </view>

  <view class="review-item card" wx:for="{{reviews}}" wx:key="id">
    <view class="flex flex-center" style="gap:12rpx;margin-bottom:12rpx">
      <image class="avatar" src="{{item.avatar}}" mode="aspectFill"/>
      <view class="flex-1">
        <text class="reviewer-name">{{item.nickname}}</text>
        <text class="review-time">{{item.created_at}}</text>
      </view>
      <view class="review-stars-wrap">
        <image wx:for="{{5}}" wx:key="*this" class="star-icon-sm" src="/images/icons/{{index < item.rating ? 'star' : 'star-empty'}}.png" mode="aspectFit"/>
      </view>
    </view>
    <text class="review-content" wx:if="{{item.content}}">{{item.content}}</text>
    <text class="review-content empty-content" wx:else>该用户未留下文字评价</text>
  </view>

  <view class="empty-state" wx:if="{{reviews.length === 0}}">
    <image class="icon-lg" src="/images/icons/star.png" mode="aspectFit"/>
    <text>暂无评价</text>
  </view>
</view>
