.profile-page { padding: 0 24rpx 40rpx; }

.user-card {
  background: linear-gradient(135deg, #36B37E, #57D9A3);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

.user-top { gap: 24rpx; }

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
}

.user-nick {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.user-campus {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-top: 6rpx;
}

.credit-bar {
  margin-top: 12rpx;
  gap: 8rpx;
}

.credit-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
}

.credit-progress {
  width: 120rpx;
  height: 8rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 4rpx;
  overflow: hidden;
}

.credit-fill {
  height: 100%;
  background: #FFD700;
  border-radius: 4rpx;
}

.credit-score {
  font-size: 22rpx;
  color: #FFD700;
  font-weight: 600;
}

.edit-btn {
  color: rgba(255,255,255,0.9);
  font-size: 24rpx;
  border: 2rpx solid rgba(255,255,255,0.5);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.login-card {
  background: linear-gradient(135deg, #36B37E, #57D9A3);
  border-radius: 24rpx;
  padding: 60rpx 32rpx;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.login-tip {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.login-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-top: 8rpx;
}

.wallet-card { margin-bottom: 20rpx; }

.wallet-label {
  font-size: 26rpx;
  color: #8F92A1;
  display: block;
}

.wallet-balance { margin-top: 8rpx; }
.wallet-amount { font-size: 44rpx; color: #172B4D; font-weight: 700; }
.wallet-arrow { font-size: 28rpx; color: #B0B3BE; }

.stats-card { margin-bottom: 20rpx; }

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
  padding: 8rpx 0;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #172B4D;
  display: block;
}

.stat-name {
  font-size: 24rpx;
  color: #8F92A1;
  display: block;
  margin-top: 4rpx;
}

.menu-card { margin-bottom: 20rpx; padding: 0; }

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #F4F5F7;
}

.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-text { font-size: 28rpx; color: #172B4D; }
.menu-arrow { font-size: 24rpx; color: #B0B3BE; }
.menu-sub { font-size: 22rpx; color: #B0B3BE; margin-right: 8rpx; }

.msg-badge {
  background: #FF5630;
  color: #fff;
  font-size: 20rpx;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 17rpx;
  padding: 0 8rpx;
  margin-right: 8rpx;
}

.logout-btn {
  text-align: center;
  color: #FF5630;
  font-size: 28rpx;
  padding: 28rpx 0;
  background: #fff;
  border-radius: 20rpx;
  margin-top: 20rpx;
}
