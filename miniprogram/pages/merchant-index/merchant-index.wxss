.shop-header {
  background: linear-gradient(135deg, #36B37E, #57D9A3);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}
.shop-name { font-size: 40rpx; font-weight: 800; color: #fff; display: block; }
.shop-rating { font-size: 26rpx; color: rgba(255,255,255,0.8); display: block; margin-top: 8rpx; }

.menu-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.menu-card {
  width: calc(50% - 8rpx);
  text-align: center;
  padding: 32rpx 20rpx;
}
.menu-emoji { font-size: 56rpx; display: block; margin-bottom: 12rpx; }
.menu-name { font-size: 30rpx; font-weight: 700; color: #172B4D; display: block; }
.menu-desc { font-size: 22rpx; color: #8F92A1; display: block; margin-top: 6rpx; }
