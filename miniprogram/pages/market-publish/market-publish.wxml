<view class="container">
  <view class="page-header">
    <text class="page-title">发布二手商品</text>
  </view>
  <view class="form-card card">
    <view class="form-group">
      <text class="form-label">商品标题 *</text>
      <input class="form-input" placeholder="如：九成新高数教材" value="{{form.title}}" bindinput="onInput" data-field="title"/>
    </view>
    <view class="form-group">
      <text class="form-label">商品描述 *</text>
      <textarea class="form-textarea" placeholder="详细描述商品成色、使用情况等" value="{{form.description}}" bindinput="onInput" data-field="description"/>
    </view>
    <view class="form-group">
      <text class="form-label">售价（元）*</text>
      <input class="form-input" type="digit" placeholder="请输入售价" value="{{form.price}}" bindinput="onInput" data-field="price"/>
    </view>
    <view class="form-group">
      <text class="form-label">原价（元）</text>
      <input class="form-input" type="digit" placeholder="可选填" value="{{form.original_price}}" bindinput="onInput" data-field="original_price"/>
    </view>
    <view class="form-group">
      <text class="form-label">分类 *</text>
      <picker mode="selector" range="{{categories}}" bindchange="onCateChange">
        <view class="form-input" style="display:flex;align-items:center;justify-content:space-between;">
          <text class="{{form.category ? '' : 'placeholder'}}">{{form.category || '请选择分类'}}</text>
          <text style="color:#B0B3BE">▾</text>
        </view>
      </picker>
    </view>
    <view class="form-group">
      <text class="form-label">商品图片</text>
      <view class="img-upload-area">
        <view class="img-item" wx:for="{{form.images}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill"/>
          <view class="img-del" catchtap="delImg" data-index="{{index}}">✕</view>
        </view>
        <view class="img-add" bindtap="addImg" wx:if="{{form.images.length < 9}}">
          <text>+</text>
          <text class="img-add-text">添加图片</text>
        </view>
      </view>
    </view>
    <view class="form-group">
      <text class="form-label">联系方式</text>
      <input class="form-input" placeholder="微信号/手机号" value="{{form.contact}}" bindinput="onInput" data-field="contact"/>
    </view>
  </view>
  <view class="btn-primary submit-btn" bindtap="submit">{{isEdit ? '保存修改' : '发布商品'}}</view>
</view>
