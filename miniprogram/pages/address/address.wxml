<view class="container">
  <view class="addr-item card" wx:for="{{addresses}}" wx:key="id">
    <view class="flex flex-between">
      <view class="flex-1">
        <view class="addr-top">
          <text class="addr-name">{{item.name}}</text>
          <text class="addr-phone">{{item.phone}}</text>
          <view class="tag tag-green" wx:if="{{item.is_default}}">默认</view>
        </view>
        <text class="addr-detail">{{item.campus}} {{item.dormitory}} {{item.detail}}</text>
      </view>
    </view>
    <view class="addr-actions flex flex-between">
      <view class="set-default" bindtap="setDefault" data-id="{{item.id}}" wx:if="{{!item.is_default}}">设为默认</view>
      <view class="flex" style="gap:24rpx">
        <text class="action-link" bindtap="editAddr" data-id="{{item.id}}">编辑</text>
        <text class="action-link del-link" bindtap="delAddr" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{addresses.length === 0}}">
    <image class="icon-lg" src="/images/icons/location.png" mode="aspectFit"/>
    <text>暂无收货地址</text>
  </view>

  <view class="btn-primary add-btn" bindtap="addAddr">+ 新增地址</view>
</view>
