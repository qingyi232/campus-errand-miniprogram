.filter-bar { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.filter-item { padding: 12rpx 28rpx; border-radius: 28rpx; font-size: 26rpx; background: #fff; color: #505F79; }
.filter-item.active { background: #36B37E; color: #fff; }
.task-type { display: block; font-size: 28rpx; font-weight: 600; color: #172B4D; margin-top: 12rpx; }
