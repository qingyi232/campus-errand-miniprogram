.market-page { padding-bottom: 20rpx; }

.search-wrap {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  gap: 16rpx;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  height: 68rpx;
  background: #F4F5F7;
  border-radius: 34rpx;
  padding: 0 24rpx;
}

.search-icon { margin-right: 12rpx; font-size: 28rpx; }
.search-input { flex: 1; font-size: 26rpx; }

.publish-btn {
  background: #36B37E;
  color: #fff;
  padding: 14rpx 28rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

.cate-scroll {
  white-space: nowrap;
  background: #fff;
  padding: 0 24rpx 16rpx;
}

.cate-list { display: inline-flex; gap: 16rpx; }

.cate-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: #F4F5F7;
  color: #505F79;
}

.cate-item.active { background: #E3FCEF; color: #36B37E; font-weight: 600; }

.sort-bar {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 24rpx;
  background: #fff;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #F4F5F7;
}

.sort-item {
  font-size: 24rpx;
  color: #8F92A1;
  padding: 4rpx 0;
}

.sort-item.active { color: #36B37E; font-weight: 600; border-bottom: 4rpx solid #36B37E; }

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  gap: 16rpx;
}

.goods-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.goods-cover { width: 100%; height: 280rpx; }

.goods-body { padding: 16rpx; }

.goods-title {
  font-size: 26rpx;
  color: #172B4D;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 10rpx;
  line-height: 1.4;
  min-height: 72rpx;
}

.goods-meta {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.goods-meta .price { font-size: 32rpx; }

.original-price {
  font-size: 22rpx;
  color: #B0B3BE;
  text-decoration: line-through;
}

.goods-seller { gap: 6rpx; }

.avatar-xs {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #F0F1F3;
}

.seller-name { font-size: 22rpx; color: #8F92A1; flex: 1; }
.view-count { font-size: 20rpx; color: #B0B3BE; }

.empty-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
